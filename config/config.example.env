# Azure Configuration for Velero
# Copy this file to config.env and fill in your values

# Azure Subscription ID
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# Resource Group name (will be created if it doesn't exist)
AZURE_RESOURCE_GROUP=velero-rg

# Azure Region
AZURE_LOCATION=eastus

# Storage Account name prefix (will have timestamp appended for uniqueness)
STORAGE_ACCOUNT_PREFIX=velerobackup

# Blob Container name for Velero backups
BLOB_CONTAINER=velero-backups
