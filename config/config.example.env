# Azure Configuration for Velero (Workload Identity)
# Copy this file to config.env and fill in your values
# config.env is git-ignored — never commit it

# Azure Subscription ID
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# Resource Group (created if it doesn't exist)
AZURE_RESOURCE_GROUP=velero-rg

# Azure Region
AZURE_LOCATION=eastus

# AKS cluster name (needed to enable OIDC issuer and Workload Identity)
AKS_CLUSTER_NAME=your-aks-cluster-name

# Storage Account name prefix (timestamp appended for uniqueness, max 24 chars total)
STORAGE_ACCOUNT_PREFIX=velerobackup

# Blob Container name for Velero backups
BLOB_CONTAINER=velero-backups

# User-Assigned Managed Identity name
MANAGED_IDENTITY_NAME=velero-identity

# The following are populated automatically by setup-azure.sh after provisioning:
# STORAGE_ACCOUNT=
# IDENTITY_CLIENT_ID=
# IDENTITY_RESOURCE_ID=
# OIDC_ISSUER=
